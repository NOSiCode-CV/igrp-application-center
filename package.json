{
  "name": "@igrp/applications-center",
  "version": "0.2.0",
  "description": "IGRP Applications Center",
  "displayName": "IGRP Applications Center",
  "private": true,
  "author": "IGRP Team | NOSi E.P.E - Núcleo Operacional Para a Sociedade de Informação",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm lint && pnpm lint:i18n && next build --turbopack",
    "lint:i18n": "igrp-i18n check-catalogs src/i18n/messages --default pt && igrp-i18n check-literals src/app/layout.tsx src/app/global-error.tsx src/app/not-found.tsx \"src/app/(igrp)/layout.tsx\" \"src/app/(auth)\" src/features/users src/features/workspace/components/home-apps src/features/settings src/features/applications \"src/app/(igrp)/(home)/settings/applications\" src/features/menus \"src/app/(invite)\" src/features/branding \"src/app/(igrp)/(home)/settings/customization\"",
    "start": "next start --port 3000",
    "branding:defaults": "node scripts/branding-defaults.mjs",
    "lint": "biome check --write",
    "format": "biome format --write && biome format --error-on-warnings .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:ui": "node scripts/check-ui-rules.mjs",
    "release": "pnpm i && pnpm build && pnpm start",
    "clean-all": "rimraf node_modules && rimraf .next",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@igrp/framework-next": "0.2.0-beta.12",
    "@igrp/framework-next-auth": "0.2.0-beta.8",
    "@igrp/framework-next-ui": "0.2.0-beta.12",
    "@igrp/igrp-framework-react-design-system": "0.2.0-beta.8",
    "@igrp/platform-access-management-client-ts": "0.2.0-beta.19",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "nanoid": "6.0.2",
    "next": "15.5.28",
    "next-auth": "4.24.15",
    "next-intl": "^4.14.9",
    "radix-ui": "1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.6",
    "react-hook-form": "7.90.0",
    "redis": "5.12.1",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@igrp/framework-next-i18n": "0.2.0-beta.3",
    "@igrp/framework-next-types": "0.2.0-beta.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/culori": "4.0.1",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
