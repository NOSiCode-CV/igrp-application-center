{
  "name": "@igrp/applications-center",
  "version": "0.1.0",
  "description": "IGRP Applications Center",
  "displayName": "IGRP Applications Center",
  "private": true,
  "author": "IGRP Team | NOSi E.P.E - Núcleo Operacional Para a Sociedade de Informação",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm format && next build --turbopack",
    "start": "next start",
    "lint": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui-rules.mjs",
    "release": "pnpm i && pnpm build && pnpm start",
    "clean-all": "rimraf node_modules && rimraf .next",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@igrp/framework-next": "0.1.0-beta.140",
    "@igrp/framework-next-auth": "0.1.0-beta.133",
    "@igrp/framework-next-types": "0.1.0-beta.135",
    "@igrp/framework-next-ui": "0.1.0-beta.139",
    "@igrp/igrp-framework-react-design-system": "0.1.0-beta.131",
    "@igrp/platform-access-management-client-ts": "0.2.0-beta.9",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.9",
    "next": "^15.5.18",
    "next-auth": "4.24.14",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "7.76.0",
    "shadcn": "^4.8.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.x.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
