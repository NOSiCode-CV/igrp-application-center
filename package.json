{
  "name": "@igrp/applications-center",
  "version": "0.2.0",
  "description": "IGRP Applications Center",
  "displayName": "IGRP Applications Center",
  "private": true,
  "author": "IGRP Team | NOSi E.P.E - Núcleo Operacional Para a Sociedade de Informação",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "biome format --error-on-warnings . && next build --turbopack",
    "start": "next start --port 3000",
    "lint": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui-rules.mjs",
    "release": "pnpm i && pnpm build && pnpm start",
    "clean-all": "rimraf node_modules && rimraf .next",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.4.0",
    "@igrp/framework-next": "0.1.0-beta.158",
    "@igrp/framework-next-auth": "0.1.0-beta.143",
    "@igrp/framework-next-types": "0.1.0-beta.145",
    "@igrp/framework-next-ui": "0.1.0-beta.157",
    "@igrp/igrp-framework-react-design-system": "0.1.0-beta.139",
    "@igrp/platform-access-management-client-ts": "0.2.0-beta.11",
    "@tanstack/react-query": "5.101.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "nanoid": "5.1.16",
    "next": "15.5.19",
    "next-auth": "4.24.14",
    "radix-ui": "1.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-error-boundary": "6.1.2",
    "react-hook-form": "7.80.0",
    "shadcn": "4.11.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tailwindcss/postcss": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.x.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
