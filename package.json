{
  "name": "@igrp/applications-center",
  "version": "0.2.0",
  "description": "IGRP Applications Center",
  "displayName": "IGRP Applications Center",
  "private": true,
  "author": "IGRP Team | NOSi E.P.E - Núcleo Operacional Para a Sociedade de Informação",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start --port 3000",
    "lint": "biome check --write",
    "format": "biome format --write && biome format --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui-rules.mjs",
    "release": "pnpm i && pnpm build && pnpm start",
    "clean-all": "rimraf node_modules && rimraf .next",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@igrp/framework-next": "0.1.0-beta.172",
    "@igrp/framework-next-auth": "0.1.0-beta.146",
    "@igrp/framework-next-types": "0.1.0-beta.149",
    "@igrp/framework-next-ui": "0.1.0-beta.168",
    "@igrp/igrp-framework-react-design-system": "0.1.0-beta.146",
    "@igrp/platform-access-management-client-ts": "0.2.0-beta.16",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "nanoid": "6.0.1",
    "lucide-react": "1.43.0",
    "next": "15.5.25",
    "next-auth": "4.24.15",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.5",
    "react-hook-form": "7.87.0",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
